# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# Note: .env is gitignored and will never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AgentRouter Configuration
# Platform: https://agentrouter.org
# Available Models: gpt-6-astra, gpt-5.6-sol, claude-opus-5, claude-opus-4-8, deepseek-v4-flash
# ------------------------------------------------------------------------------
AGENTROUTER_API_KEY=sk-Re7j...
SYSTEM_ACCESS_TOKEN=your_system_access_token_here

# Standard OpenAI SDK routing directed to AgentRouter gateway
OPENAI_API_KEY=sk-Re7j...
OPENAI_BASE_URL=https://co.agentrouter.org/v1

# ------------------------------------------------------------------------------
# 2. OpenRouter Configuration
# Platform: https://openrouter.ai
# Models: Anthropic, OpenAI, Meta, Mistral, DeepSeek, etc.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_TITLE=Brainstorm-Ecosystem
