{
  "$schema": "../capability.contract.v1.json",
  "module": "nepali-ocr-ai",
  "version": "1.1.0",
  "location": "F:\\Aaradhya-Dev-Tamrakar\\Utility\\nepali-ocr-ai",
  "tracking_branch": "nepali-ocr-ai",
  "runtime": "python3.11",
  "mcp_endpoint": {
    "transport": "stdio",
    "command": "python",
    "args": [
      "-m",
      "nepali_ocr_ai.mcp_server"
    ]
  },
  "capabilities": [
    {
      "id": "ocr_nepali_document",
      "description": "Extracts high-fidelity Devanagari text and paragraph layouts from scanned documents, photocopies, or images using multimodal vision AI.",
      "category": "ingestion",
      "deterministic": false,
      "side_effects": false,
      "verification_tier": "empirical_sandbox",
      "cost_tier": "free_tier_api",
      "objective": "synthesize",
      "timeout_ms": 15000,
      "invariants_checked": [
        "INV-NEP-003"
      ],
      "inputs": {
        "type": "object",
        "required": [
          "image_path"
        ],
        "properties": {
          "image_path": {
            "type": "string"
          },
          "target_font_mode": {
            "type": "string",
            "enum": [
              "unicode",
              "preeti",
              "both"
            ]
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "extracted_unicode_text",
          "confidence_score"
        ],
        "properties": {
          "extracted_unicode_text": {
            "type": "string"
          },
          "confidence_score": {
            "type": "number"
          },
          "layout_blocks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "id": "check_nepali_grammar",
      "description": "Context-aware Nepali grammar and orthography checker enforcing Pragya-Pratishthan Varnavinyas (ह्रस्व/दीर्घ, श/ष/स, पदयोग/पदवियोग) and honorific agreement.",
      "category": "cognition",
      "deterministic": false,
      "side_effects": false,
      "verification_tier": "statistical_audit",
      "cost_tier": "zero_token_local",
      "objective": "audit",
      "timeout_ms": 8000,
      "invariants_checked": [
        "INV-NEP-004"
      ],
      "inputs": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "strictness": {
            "type": "string",
            "enum": [
              "formal_legal",
              "standard",
              "colloquial"
            ]
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "corrected_text",
          "issues_found"
        ],
        "properties": {
          "corrected_text": {
            "type": "string"
          },
          "issues_found": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "original": {
                  "type": "string"
                },
                "replacement": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "transcode_nepali_fonts",
      "description": "Deterministic bi-directional transcoding between Unicode Devanagari and legacy 8-bit fonts (Preeti, Kantipur) with ligature and prefix-matra preservation.",
      "category": "compute",
      "deterministic": true,
      "side_effects": false,
      "verification_tier": "formal_smt",
      "cost_tier": "zero_token_local",
      "objective": "transform",
      "timeout_ms": 5000,
      "invariants_checked": [
        "INV-NEP-001"
      ],
      "inputs": {
        "type": "object",
        "required": [
          "text",
          "source_encoding",
          "target_encoding"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_encoding": {
            "type": "string",
            "enum": [
              "unicode",
              "preeti",
              "kantipur"
            ]
          },
          "target_encoding": {
            "type": "string",
            "enum": [
              "unicode",
              "preeti",
              "kantipur"
            ]
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "converted_text",
          "character_fidelity"
        ],
        "properties": {
          "converted_text": {
            "type": "string"
          },
          "character_fidelity": {
            "type": "number"
          }
        }
      }
    },
    {
      "id": "repair_word_document",
      "description": "Parses Word (.docx) OpenXML runs, detects legacy Devanagari font hack runs, and transcodes them cleanly to Unicode (or vice versa) while preserving tables and formatting.",
      "category": "presentation",
      "deterministic": true,
      "side_effects": true,
      "verification_tier": "empirical_sandbox",
      "cost_tier": "zero_token_local",
      "objective": "transform",
      "timeout_ms": 10000,
      "invariants_checked": [
        "INV-NEP-002"
      ],
      "inputs": {
        "type": "object",
        "required": [
          "input_docx_path",
          "target_font_mode"
        ],
        "properties": {
          "input_docx_path": {
            "type": "string"
          },
          "output_docx_path": {
            "type": "string"
          },
          "target_font_mode": {
            "type": "string",
            "enum": [
              "unicode_kalimati",
              "legacy_preeti"
            ]
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "output_docx_path",
          "runs_modified",
          "tables_preserved"
        ],
        "properties": {
          "output_docx_path": {
            "type": "string"
          },
          "runs_modified": {
            "type": "integer"
          },
          "tables_preserved": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "metadata": {
    "author": "Aaradhya Dev Tamrakar",
    "license": "MIT",
    "repository_url": "https://github.com/Aaradhya-Dev-Tamrakar/brainstorm/tree/nepali-ocr-ai",
    "last_updated": "2026-09-15"
  }
}
