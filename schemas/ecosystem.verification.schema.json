{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaradhyadt.dev/schemas/ecosystem.verification.v1.json",
  "title": "Ecosystem verification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "generated_by", "projects"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_kind": { "const": "ecosystem_verification" },
    "generated_by": { "type": "string", "minLength": 1 },
    "projects": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "claimed_result", "claims", "provenance", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "claimed_result": { "type": "string", "minLength": 1 },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "scope", "evidence_tier"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "value": {},
        "scope": { "type": "string", "minLength": 1 },
        "evidence_tier": { "type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"] },
        "limitations": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_commit", "recorded_at"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "deterministic"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["verified", "claimed", "warn"] },
        "deterministic": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 }
      }
    }
  }
}
