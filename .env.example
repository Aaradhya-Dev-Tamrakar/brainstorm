# GitHub Pilot Authentication & Configuration

# Single Personal Access Token (PAT) with repo, workflow, read:user
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Target Organization(s) and User Account(s) to monitor (comma-separated)
GITHUB_ORGS=Aaradhya-Dev-Tamrakar
GITHUB_USERS=AaradhyaDT

# Cache & Storage Settings
PILOT_CACHE_DIR=.cache/pilot
PILOT_CACHE_TTL_SECONDS=21600

# Scraper Settings
PILOT_SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
